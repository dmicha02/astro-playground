<style>
    /* .badge-hover-group:hover .badge-wrapper {
  transition: opacity 0.3s ease, filter 0.3s ease;
}
.badge-hover-group:hover .badge-wrapper:not(:hover):has(~ .badge-wrapper:hover),
.badge-hover-group:hover .badge-wrapper:not(:hover):has(+ .badge-wrapper:hover) {
  opacity: 0.3;
  filter: blur(2px);
} */
.badge-wrapper.dimmed {
  opacity: 0.9;
  filter: blur(1px);
  transition: opacity 0.3s ease, filter 0.3s ease;
}
</style>
<script >
function adjustTooltips() {
  // For each visible word cloud
  document.querySelectorAll('.word-cloud:not(.hidden)').forEach(wordCloud => {
    const badgeWrappers = wordCloud.querySelectorAll('.badge-wrapper');
    const parentRect = wordCloud.getBoundingClientRect();

    badgeWrappers.forEach(wrapper => {
      const tooltip = wrapper.querySelector('.tooltip');
      if (!tooltip) return;

      // Reset tooltip classes
      tooltip.classList.remove('tooltip-right', 'tooltip-left', 'tooltip-top', 'tooltip-bottom');
      tooltip.classList.add('tooltip-bottom');

      const rect = wrapper.getBoundingClientRect();

      // Left edge
      if (rect.left - parentRect.left < 100) {
        tooltip.classList.add('tooltip-right');
        tooltip.classList.remove('tooltip-bottom');
      }
      // Right edge
      else if (parentRect.right - rect.right < 100) {
        tooltip.classList.add('tooltip-left');
        tooltip.classList.remove('tooltip-bottom');
      }
      // Bottom edge
      else if (parentRect.bottom - rect.bottom < 80) {
        tooltip.classList.add('tooltip-top');
        tooltip.classList.remove('tooltip-bottom');
      }
    });
  });
}

// Initial adjustment on page load
window.addEventListener('DOMContentLoaded', () => {
  adjustTooltips();
});

// Adjust tooltips on tab switch
document.querySelectorAll('.tab').forEach(tab => {
  tab.addEventListener('click', () => {
    // Update active tab
    document.querySelectorAll('.tab').forEach(t => t.classList.remove('tab-active'));
    tab.classList.add('tab-active');
    
    // Show/hide appropriate word cloud
    const category = tab.getAttribute('data-category');
    document.querySelectorAll('.word-cloud').forEach(cloud => {
      cloud.classList.add('hidden');
    });
    if (category === 'all') {
      document.getElementById('all').classList.remove('hidden');
    } else {
      document.getElementById(category).classList.remove('hidden');
    }
    // Adjust tooltips after tab switch
    setTimeout(adjustTooltips, 50);
  });
});

// Badge hover dimming
const badgeCloud = document.getElementById('badge-cloud');
function setupBadgeHover() {
  document.querySelectorAll('.word-cloud:not(.hidden) .badge-wrapper').forEach(wrapper => {
    wrapper.addEventListener('mouseenter', () => {
      document.querySelectorAll('.word-cloud:not(.hidden) .badge-wrapper').forEach(w => {
        if (w !== wrapper) w.classList.add('dimmed');
      });
    });
    wrapper.addEventListener('mouseleave', () => {
      document.querySelectorAll('.word-cloud:not(.hidden) .badge-wrapper').forEach(w => w.classList.remove('dimmed'));
    });
  });
}
window.addEventListener('DOMContentLoaded', setupBadgeHover);
document.querySelectorAll('.tab').forEach(tab => {
  tab.addEventListener('click', () => setTimeout(setupBadgeHover, 50));
});

      
